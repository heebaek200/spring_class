<!doctype html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>메시지 작성</title>

    <style>
        body {
            padding: 8px 10px;
            margin: 2px;
            font-family: Arial, sans-serif;
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none;
        }

        form {
            margin-top: 20px;
        }
        input {
            padding: 8px;
            width: 300px;
            margin-right: 10px;
        }
        button {
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none;
        }
    </style>
</head>
<body>
    <nav>
        <a href="/">목록</a>
        <a href="/save-form">작성</a>
    </nav>

    <h3>메시지 작성</h3>

    <form action="/chat" method="post">
        <input type="text" name="msg" id="msg" placeholder="메시지 입력" required autofocus>
        <button type="submit">전송</button>
    </form>
</body>
</html>